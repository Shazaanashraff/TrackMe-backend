{
  "name": "vehicle-tracking-backend",
  "version": "1.0.0",
  "description": "Real-time vehicle tracking system backend with Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:routes": "node scripts/seed-sri-lankan-routes.js",
    "seed:wp": "node scripts/seed-wp-routes.js",
    "seed:vehicles": "node scripts/seed-test-vehicles.js",
    "seed:manager-vehicles": "node scripts/seed-manager-vehicles-per-route.js",
    "seed:start-journeys": "node scripts/start-two-vehicles-per-route.js",
