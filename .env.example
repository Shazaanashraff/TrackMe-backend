# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.

# ---- Server ----
PORT=5000
# NODE_ENV=development

# Dev-only convenience: when the email provider isn't configured, echo the OTP
# straight back in the response body instead of emailing it, so local flows are
# completable. Requires BOTH this flag and a non-production NODE_ENV — never set
# this in a staging/production deployment.
# ENABLE_DEV_OTP_ECHO=true

# ---- Database ----
# Local Docker Mongo (see README/setup): mongodb://localhost:27017/trackme
MONGODB_URI=mongodb://localhost:27017/trackme

# ---- Auth / JWT ----
# Use long, random strings. These dev defaults are NOT safe for a shared deployment.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=15m
# Access-token lifetime. 7d in local dev keeps the live socket from dropping
# mid-session; use a short value (e.g. 15m) in production.
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS allow-list (comma-separated origins). '*' is fine for local dev.
CLIENT_ORIGINS=*

# ---- Google (server-side proxy key) ----
# Single key used by /api/places/* and /api/transit/* — Places autocomplete/details,
# Routes API transit planning, and reverse Geocoding for the drag-pin.
# SERVER-SIDE ONLY — never ship this to the client.
# Enable on the Google Cloud project (billing required):
#   - Places API (New)
#   - Routes API
#   - Geocoding API   (optional: drag-pin reverse lookup; falls back to free OSM if absent/disabled)
GOOGLE_PLACES_KEY=your-google-server-key

# ---- Custom routes (driver-recorded) ----
# Road fitting uses OpenStreetMap map matching (OSRM), not Google. The public demo
# server below is for development only; run your own OSRM/Valhalla (Sri Lanka OSM
# extract) before real use and point MAP_MATCH_URL at it.
MAP_MATCH_PROVIDER=osrm
MAP_MATCH_URL=https://router.project-osrm.org
MAP_MATCH_TIMEOUT_MS=15000
# Most trace points sent to the matcher in one request. A self-hosted OSRM allows 100 (default here 90).
# The public demo server allows only 10; the adapter also learns this on its own from 'TooBig' answers.
# MAP_MATCH_MAX_POINTS=10
# Widest road search (metres) around a GPS fix. Default 50. The public demo server refuses more than ~40;
# the adapter learns that on its own from its 'TooBig: radius' answer.
# MAP_MATCH_MAX_RADIUS=40
# How many rides build a route, and the quality gate for each recording ride.
CUSTOM_ROUTE_REQUIRED_RUNS=5
CUSTOM_ROUTE_MIN_POINTS=20
CUSTOM_ROUTE_MIN_METERS=500

# ---- Private Routes (room-key / PIN) ----
# 32-byte key (hex or base64) for AES-256-GCM encryption of room-key codes so the
# owning manager can reveal/copy them. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_KEY_SECRET=dev-room-key-secret-change-me-0123456789ab
# HMAC key for the deterministic room-key lookup hash (manual-entry lookup + uniqueness).
ROOM_KEY_PEPPER=dev-room-key-pepper-change-me
# Wrong-code attempts allowed before a (user, route) lockout with escalating backoff.
ROOM_KEY_MAX_ATTEMPTS=5

# ---- QR Attendance (rotating signed boarding/alighting token) ----
# Dedicated secret for QR tokens — NEVER reuse JWT_SECRET (see
# docs/features/qr-attendance/QR_ATTENDANCE_PLAN.md). Generate the same way as JWT_SECRET.
QR_JWT_SECRET=dev-qr-jwt-secret-change-me
# QR token lifetime. Combined with RouteMembership.tokenVersion for instant revocation.
QR_TOKEN_TTL=24h
# Duplicate same-type scan window (seconds) for a given student+bus — treated as an
# idempotent replay rather than a new BoardingEvent.
QR_SCAN_DEBOUNCE_SECONDS=30

# ---- Optional ----
# Google OAuth client ID for verifying Google sign-in (leave blank to disable).
GOOGLE_CLIENT_ID=
# Resend transactional email (verification + manager invite/reset links). Blank
# disables outbound email; locally, create users pre-verified and use the on-screen
# demo invite link instead. When set, manager invites/resets are emailed for real
# and the demo link is disabled.
RESEND_API_KEY=
# Verified sender. onboarding@resend.dev only delivers to your own Resend-account
# email; use a verified-domain address to email arbitrary managers.
RESEND_FROM=onboarding@resend.dev
# SMTP fallback (nodemailer). Used when Resend is unset OR Resend rejects/throws, so
# a not-yet-verified Resend domain no longer silently drops OTP emails. All of
# SMTP_HOST / SMTP_USER / SMTP_PASS must be set to enable it. SMTP_FROM defaults to
# SMTP_USER; SMTP_SECURE defaults to true only on port 465 (587 uses STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Base URL of the WebAdmin SPA (where /activate lives), used to build invite links.
ADMIN_APP_URL=http://localhost:5173
# Set to 1 for verbose Socket.IO logs.
SOCKET_DEBUG=

# Lets an owning manager view a driver's password in the clear
# (src/utils/recoverablePassword.js). A driver may have no email, so the manager
# has to be able to relay the credential.
#
# TRADE-OFF: this stores a reversible copy alongside the bcrypt hash. A database
# leak plus this key is a plaintext credential leak. Leave it UNSET to switch the
# feature off entirely — nothing is stored and the endpoint returns 503.
# Authentication never reads it; the bcrypt hash remains the only login check.
#
# Generate with: openssl rand -hex 32
DRIVER_PASSWORD_KEY=

# Rider account deletion (docs/modules/AUTH.md section 8). Days between a delete
# request and the purge; signing in before then keeps the account. Unset = 3.
# 0 purges at the next sweep (handy to try the purge locally).
ACCOUNT_DELETION_GRACE_DAYS=3
