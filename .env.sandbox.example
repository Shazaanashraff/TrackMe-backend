# Copy this file to .env.sandbox and fill in the values.
# .env.sandbox is gitignored — never commit real secrets.
#
# This is the SANDBOX backend process (see docs/modules/SANDBOX.md). It runs alongside
# the normal dev server on a different port, against a different database, so Developer
# Mode's CRUD testing can never touch dev/prod data. Start it with `npm run dev:sandbox`.

# ---- Server ----
PORT=5001

# ---- Database ----
# Must be a *_sandbox database — scripts/seed-sandbox.js refuses to run against anything
# whose name doesn't contain "sandbox", and this is also what /health's `mode` field
# checks to report "sandbox" vs "primary".
MONGODB_URI=mongodb://localhost:27017/trackme_sandbox

# ---- Auth / JWT ----
# MUST be the exact same value as JWT_SECRET in your dev .env. This is what lets one
# access token, minted by the dev backend on :5000, also authenticate on the sandbox
# backend on :5001 when you flip the Developer page's sandbox toggle — see
# "Session on toggle" in DEVELOPER_MODE_PLAN.md.
JWT_SECRET=dev-jwt-secret-change-me
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me
REFRESH_TOKEN_EXPIRES_IN=7d

CLIENT_ORIGINS=*

# ---- Sandbox seed (scripts/seed-sandbox.js) ----
# The dev database's superadmin profile _id (Manager/SuperAdmin collection, not
# Identity). Get it with `db.superadmins.findOne()._id` against your dev MONGODB_URI,
# or read `user._id` from a dev POST /api/auth/login response. seed-sandbox.js creates
# the sandbox superadmin with this exact _id so a dev-issued JWT — which carries this
# id — resolves to a real account on the sandbox backend too (see
# middleware/auth.js's `protect`, which looks up by profile _id, not by email).
SANDBOX_MIRROR_SUPERADMIN_ID=
# Only used the first time the sandbox superadmin is created; safe to leave at the
# dev defaults since this is a throwaway sandbox database.
SUPERADMIN_EMAIL=superadmin@trackme.dev
SUPERADMIN_PASSWORD=sandbox-password-change-me

# ---- Everything below only matters if you're exercising the feature that uses it ----
GOOGLE_PLACES_KEY=
GOOGLE_ROADS_KEY=
CUSTOM_ROUTE_THRESHOLD_METERS=150
CUSTOM_ROUTE_THRESHOLD_FRACTION=0.35
ROOM_KEY_SECRET=dev-room-key-secret-change-me-0123456789ab
ROOM_KEY_PEPPER=dev-room-key-pepper-change-me
ROOM_KEY_MAX_ATTEMPTS=5
QR_JWT_SECRET=dev-qr-jwt-secret-change-me
QR_TOKEN_TTL=24h
QR_SCAN_DEBOUNCE_SECONDS=30
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM=
SOCKET_DEBUG=
